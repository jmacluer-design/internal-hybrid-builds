+    let runtime = &mut skater.respawn;
+    let candidate = runtime.history.automatic(
+        stance,
+        &mut Scene {
+            world: &physics.world,
+            settings: &runtime.settings,
+        },
+    )?;
+    let mut transform = candidate.transform;
+    transform[3][1] += RETURN_LIFT;
+    skater.player_input.request_teleport(transform)?;
+    skater.animation.request_checkpoint_stance(candidate.stance);
+    skater.teleport_state.request_manual(transform, !candidate.offboard);
+    Ok(())
+}
