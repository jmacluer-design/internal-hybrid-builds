+                let s = (1.0 + m[1][1] - m[0][0] - m[2][2]).sqrt() * 2.0;
+                [(m[0][1] + m[1][0]) / s, 0.25 * s, (m[1][2] + m[2][1]) / s, (m[0][2] - m[2][0]) / s]
+            } else {
